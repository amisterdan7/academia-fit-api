# URI do banco no Supabase.
# Onde pegar: painel do projeto > botão "Connect" > Method: "Session pooler" > copie a URI
# e troque [YOUR-PASSWORD] pela senha do banco (sem os colchetes).
# Se a senha tiver @ # / : ? use só letras e números, ou codifique: @=%40  #=%23  /=%2F  :=%3A  ?=%3F
# Esta URL é segredo: fica só aqui (e nas variáveis do servidor), nunca no site, no app ou no desktop.
DATABASE_URL=https://eptyjpdpcvindwlspewb.supabase.co

# Certificado do Supabase: painel > Database Settings > SSL Configuration > Download.
# Salve como certs/supabase-ca.crt (o certificado é público, pode ir para o GitHub) e aponte aqui.
# Em Render/Railway você também pode colar o texto do certificado trocando as quebras de linha por \n.
DATABASE_SSL_CA=./certs/supabase-ca.crt
# Se aparecer o erro "Hostname/IP does not match certificate's altnames", troque para false.
DATABASE_SSL_VERIFICAR_HOST=true

# Segredo para assinar os tokens de login (mínimo de 32 caracteres).
# Gere um com:  node setup-env.mjs
JWT_SECRET=

# Validade do login, em horas
JWT_EXPIRA_HORAS=8

PORT=3333

# Domínios do site vitrine que podem chamar a API pelo navegador (separados por vírgula).
# Em produção, coloque o endereço real do site. Exemplo: https://minhaacademia.com.br
CORS_ORIGINS=http://localhost:5173

# Quantos proxies existem na frente da API. Em Render ou Railway use 1; no seu computador, 0.
TRUST_PROXY=0

# Fuso usado nas datas de matrícula e vencimento
FUSO_NEGOCIO=America/Sao_Paulo
